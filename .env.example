# Copy to .env.local and fill in. .env.local is gitignored.

# backend/supabase/functions/public-listings — holds the Guesty OAuth secret
# server-side and mints one shared token, rather than the browser minting its
# own against Guesty's ~5-token/24h cap.
VITE_LISTINGS_API=

# backend/supabase/functions/public-availability — same pattern, per-listing
# calendar. Currently always reports { known: false } until Guesty enables
# the availability-pricing scope on this account.
VITE_AVAILABILITY_API=

# Optional: base URL of the Guesty Booking Engine, used for "Request to book".
VITE_GUESTY_BOOKING_URL=
